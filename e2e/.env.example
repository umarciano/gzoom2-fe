# Copia in .env (il file .env NON va committato).
E2E_BASE_URL=http://localhost:4200

# Password unica di TUTTI gli utenti dell'ambiente di test.
E2E_PASS=ofbiz

# ============================================================================
# Le spec DINAMICHE (validazione-workflow, stampe-e-visibilita, consuntivazione-referente)
# NON usano utenti fissi: derivano a runtime dal DB — con ORDER BY random(), quindi DIVERSI ad
# ogni esecuzione — sia la scheda sia l'attore (Dir UO = ORG_RESPONSIBLE della UO; Dir San/Amm e
# Referente dai rispettivi gruppi). Non serve configurare credenziali per queste.
#
# Le variabili utente qui sotto servono SOLO alle 2 spec "legacy":
#   - menu-performance-strategica-gating (admin + utente senza profilo strategica)
#   - visibilita-scheda-init (admin + un Dir UO specifico)
# ============================================================================
E2E_ADMIN_USER=admin
E2E_ADMIN_PASS=ofbiz
E2E_DIRUO_USER=rossella.dangelo
E2E_DIRUO_PASS=ofbiz
E2E_NOPROF_USER=adele.sannino
E2E_NOPROF_PASS=ofbiz

# ============================================================================
# DB (Postgres) — usato dalle spec dinamiche per trovare scheda/attore a runtime.
# Default = cardarelli locale.
# ============================================================================
E2E_DB_HOST=localhost
E2E_DB_PORT=5432
E2E_DB_NAME=cardarelli
E2E_DB_USER=postgres
E2E_DB_PASS=postgres
